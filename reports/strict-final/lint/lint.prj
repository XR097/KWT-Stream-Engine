set_option incdir {<KSE>/third-party/e203/rtl/e203/core}
set_option top kse_accel_sys
set_option enableSV09 yes
set_option define {KSE_SIM}
set_option mthresh 70000
current_methodology $SPYGLASS_HOME/GuideWare/latest/block/initial_rtl
current_goal lint/lint_rtl -top kse_accel_sys
set_parameter handle_large_bus yes
run_goal
exit -save
