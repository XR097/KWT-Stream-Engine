read_file -type verilog {<KSE>/tb/models/RAMSP128X16_beh.sv}
read_file -type verilog {<KSE>/tb/models/RAMSP1024X16_beh.sv}
read_file -type verilog {<KSE>/tb/models/RAMSP4096X16_beh.sv}
